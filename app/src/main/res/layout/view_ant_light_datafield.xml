<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAntDataFieldRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121318"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Header: Light Name, Radar Warning Indicator & Battery -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAntLightName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="LEZYNE RADAR"
            android:textColor="#3875F6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAntRadarStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="RADAR FREI"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAntBatteryField"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main In-Ride Interactive Button: Mode Switcher (Cycles Modes) -->
    <Button
        android:id="@+id/btnAntCycleMode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:background="#282A33"
        android:text="TAGFAHRLICHT"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Secondary In-Ride Button: Quick Toggle Power (ON/OFF) -->
    <Button
        android:id="@+id/btnAntToggleLight"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="#1C1D24"
        android:text="LICHT AUS"
        android:textColor="#9E9EA7"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
