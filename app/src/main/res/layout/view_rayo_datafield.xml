<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutDataFieldRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121318"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="5dp">

    <!-- Header: App Name & Battery -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RAYO"
            android:textColor="#FF2A55"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBatteryField"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main In-Ride Interactive Button: Light Toggle (Slightly reduced in height, text +50%) -->
    <Button
        android:id="@+id/btnToggleLight"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:layout_weight="1.1"
        android:background="#282A33"
        android:text="LICHT AUS"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <!-- Secondary In-Ride Button: Cycle Profile (Enlarged touch area & text size) -->
    <Button
        android:id="@+id/btnCycleProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="1dp"
        android:layout_weight="0.9"
        android:background="#1F2029"
        android:text="PROFIL 1"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
